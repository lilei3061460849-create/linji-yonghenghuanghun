# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.venv/
dist/
build/

# Data (databases and saves)
data/*.db
data/saves/
data/sealed_candidate.json
data/test_*
data/dbg*
data/demo_*
data/batch_*

# 演武场角色卡：data/player_characters.json 会提交进仓库（换设备不丢），
# 只忽略写入过程中的临时文件。
data/.characters-*

# 大文件 / 会话备份（历史上误提交过 5.4MB 的 linji_session.bundle，见 98d8abd0）
*.bundle
*.patch

# Secrets / local environment
# .env.example 是模板，必须提交；真正的 .env 一律不提交。
.env
.env.*
!.env.example

# Tool caches (ruff / mypy / coverage)
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

