# 环境变量模板。复制成 .env 后填写（.env 与 .env.* 已被 .gitignore 忽略，禁止提交）。
#
# 说明：项目运行时零第三方依赖，引擎本身不读任何密钥；只有 AI 驱动层
# （engine/ai_player.py）与实验脚本（sim/）会读下面的变量。
# 本文件只是清单，Python 不会自动读取 .env —— 需要自己 export 或 source。

# ---------- AI 后端凭证（只有用 LLM 扮演玩家时才需要，任选其一）----------
# Google Gemini 的 API key。免费额度申请：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq 的 API key（OpenAI 兼容接口，速度快）。申请：https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter 的 API key（可选免费模型）。申请：https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DeepSeek 的 API key。申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---------- 可玩网页界面（webapp/server.py）----------
# 监听地址。默认 127.0.0.1（仅本机）。改成 0.0.0.0 会对外开放，见 README 的风险说明。
HOST=127.0.0.1
# 监听端口，默认 8000。
PORT=8000

# ---------- 引擎与实验开关 ----------
# DM 裁定库（SQLite）路径覆盖；默认 data/dm_rulings.db。
LJ_DB_PATH=
# 打开"污染守卫"：预演/沙盒路径若改动了运行时状态就报错。设 1 开启，默认关闭。
LJ_POLLUTION_GUARD=
# 只记录胜局（1 为默认；0 = 也保留败局样本）。sim/build_learner.py、sim/duel_pvp.py 使用。
LJ_WIN_ONLY=
# 生成真实胜者样本的输出目录；默认 data/real_winners。CI 里用 artifacts/ 目录。
REAL_WINNER_DIR=

# ---------- 规则型 AI 启发式开关（engine/ai_tactics.py，生产路径已停用，仅模拟/测试）----------
# 是否允许普攻作为候选（0 关闭）。默认 1。
LJ_AI_BASIC_ATTACK=
# 死斗中是否闪避（0 关闭）。默认 1。
LJ_AI_DUEL_DODGE=
# 怪物是否闪避（0 关闭）。默认 1。
LJ_AI_MONSTER_DODGE=
# 设为 1 时把"收割/汲取"类代价决策打到 stderr，便于排查。
LJ_AI_HARVEST_DUMP=
# 自我保全倾向开关（engine/ai_tactics.py 顶部读取）。默认 1。
LJ_SELF_PRESERVE=

# ---------- 模糊测试 ----------
# tests/test_resolution_fuzz.py 的用例数下限，默认 2000。
LJ_FUZZ_CASES=

# ---------- 构筑学习（sim/build_learner.py）参数 ----------
# 先验模式：confirmed | legacy。默认 confirmed。
BL_PRIOR_MODE=
# 先验权重比例，默认 0.75。
BL_PRIOR_RATIO=
# 取先验前 N 名，默认 3。
BL_PRIOR_TOP=
# 先验生效所需最少评测次数，默认 2。
BL_PRIOR_MIN_EVALS=
# 先验变异概率，默认 0.5。
BL_PRIOR_MUTATE=
# 每 N 轮做一次深挖，默认 15。
BL_DEEPEN_EVERY=
# 深挖前 N 名，默认 3。
BL_DEEPEN_TOP=
# 每个深挖候选跑几次，默认 2。
BL_DEEPEN_RUNS=

# ---------- 报表/其它实验脚本 ----------
# sim/victory_path_tournament.py 的结果输出路径，默认 /tmp/vt_results.json。
VT_OUT=
# 同上：只跑指定行（逗号分隔）。
VT_ROWS=
# sim/build_winrate.py 的调试输出开关（设任意非空值即打印）。
WINRATE_DEBUG=
# sim/blade_session.py 的会话状态文件，默认 /tmp/linji_blade/session.json。
BLADE_SESSION=
# test_real_playthrough.py 的详细模式（设 1 打开逐回合日志）。
DETAIL=
